{
  "name": "homedash",
  "private": true,
  "version": "3.2.12",
  "description": "Customizable Home Lab Dashboard",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm --filter backend run test:integration",
    "test:e2e": "pnpm --filter frontend run test:e2e",
    "version:check": "node scripts/version-state.mjs validate",
    "version:bump-main": "node scripts/version-state.mjs bump-main",
    "test:release-version": "node --test scripts/version-state.test.mjs",
    "test:release-workflow": "node --test scripts/release-workflow.test.mjs",
    "test:upgrade": "bash .github/skills/pre-pr-upgrade-gate/run.sh",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.32.0"
  }
}
