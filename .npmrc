# Package registry for npm and pnpm.
#
# Direct requests to registry.npmjs.org are blocked on the networks this
# project is built on, so every registry request — packuments, tarballs and
# provenance attestations alike — has to go through the feed proxy. pnpm
# derives all of those URLs from this setting, so setting it once here is
# enough.
#
# Keeping it in the repo rather than in a developer's ~/.npmrc means container
# builds get it too: both Dockerfiles COPY this file in before installing
# anything. Override locally with `npm_config_registry=<url>` if you are on a
# network that reaches npmjs.org directly.
registry=https://packagefeedproxy.microsoft.io/npm/

# The proxy is slower and flakier than npmjs.org under load — container builds
# saw sporadic ETIMEDOUTs on tarball fetches. Fewer parallel connections and
# more patient retries keep an install from failing on a single slow package.
network-concurrency=8
fetch-retries=5
fetch-timeout=120000
fetch-retry-maxtimeout=120000
