{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "description": "HomeDash API server",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format cjs --dts --clean && tsup scripts/reset-admin.ts --format cjs --outDir dist/scripts --no-dts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "openapi:lint": "redocly lint ../specs/001-homelab-dashboard/contracts/openapi.yaml"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.41.0",
    "better-sqlite3": "^11.3.0",
    "croner": "^10.0.1",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.4",
    "node-ical": "^0.26.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1",
    "sharp": "^0.35.4",
    "sonos": "^1.14.3",
    "ua-parser-js": "^1.0.38",
    "undici": "^8.10.2",
    "yahoo-finance2": "^3.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@redocly/cli": "^1.18.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^1.6.0",
    "drizzle-kit": "0.31.10",
    "supertest": "^7.0.0",
    "tsup": "^8.2.1",
    "tsx": "^4.15.7",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "yaml": "3.0.0-1"
  }
}
